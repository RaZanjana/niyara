---
/**
 * Gallery ("Photographs"): one large picture at a time, changing by itself.
 *
 * - Every few seconds the next picture sweeps in across the last one, like a
 *   slow wipe in a film, while each picture drifts gently closer for as long
 *   as it is shown. A thin line under the current thumbnail fills as its
 *   time runs. Behind the frame, a soft glow takes the colors of the picture.
 * - The show waits while the pointer is on the picture, while the keyboard is
 *   inside the gallery, while the gallery is off screen, and whenever the
 *   pause button is pressed. It does not start by itself for visitors who
 *   prefer reduced motion.
 * - Arrows, thumbnails, a swipe, or the left and right keys change the picture.
 * - On a wide screen the picture and everything about it share one row: the
 *   picture on the left, and beside it the caption, the list of photographs
 *   (each with its title) and the controls. On a phone they stack.
 * - On a desktop, moving the pointer across a picture shifts it slightly, as
 *   if looking around.
 *
 * The behavior is in scripts/ui/gallery.ts. Without scripts the pictures are
 * shown as a row that scrolls sideways.
 */
import Ambient from '@/components/ui/Ambient.astro';
import Media from '@/components/ui/Media.astro';
import Scene from '@/components/ui/Scene.astro';
import TextLink from '@/components/ui/TextLink.astro';
import { galleryIntro, gallerySlides } from '@/data/gallery';
import { pageHref } from '@/data/routes';
import { getScene } from '@/data/scenes';

const scene = getScene('photographs');
const first = gallerySlides[0];
---

<Scene id="photographs" class="gallery">
  <div class="container gallery__inner" data-scene-body>
    <header class="gallery__header">
      <div class="gallery__titles">
        <p class="label" data-reveal>
          {scene.label}
        </p>
        <h2 id="photographs-title" class="gallery__heading" data-split-lines>
          {galleryIntro.heading}
        </h2>
      </div>
      <p class="muted gallery__hint" data-reveal>
        {galleryIntro.hint}
      </p>
    </header>

    <div class="gallery__viewer" data-gallery data-reveal>
      <div class="gallery__frame">
        <div class="gallery__glow" aria-hidden="true">
          {gallerySlides.map((slide, index) => (
            <Ambient shot={slide.shot} data-gallery-glow data-active={index === 0} />
          ))}
        </div>

        <div
          class="gallery__stage no-scrollbar"
          data-gallery-stage
          tabindex="0"
          role="group"
          aria-roledescription="carousel"
          aria-label="Photographs of Niyara"
        >
          {gallerySlides.map((slide, index) => (
            <figure
              class="gallery__slide"
              data-gallery-slide
              data-active={index === 0}
              data-title={slide.title}
              data-caption={slide.caption}
            >
              <div class="gallery__picture" data-gallery-picture>
                <Media shot={slide.shot} sizes="(min-width: 85em) 85rem, 100vw" />
              </div>
              <figcaption class="gallery__slide-caption">
                <strong>{slide.title}.</strong> {slide.caption}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>

      <div class="gallery__bar">
        <div class="gallery__caption" data-gallery-text>
          <p class="gallery__caption-title" data-gallery-title>
            {first?.title}
          </p>
          <p class="muted" data-gallery-caption>
            {first?.caption}
          </p>
        </div>
        <div class="gallery__controls">
          <p class="muted gallery__count" data-gallery-count>
            1 of {gallerySlides.length}
          </p>
          <button
            type="button"
            class="round-button gallery__toggle"
            data-gallery-toggle
            aria-label="Pause the slideshow"
          >
            <svg
              class="gallery__icon-pause"
              aria-hidden="true"
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="none"
            >
              <path d="M7.5 5V15M12.5 5V15" stroke="currentColor"></path>
            </svg>
            <svg
              class="gallery__icon-play"
              aria-hidden="true"
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="none"
            >
              <path d="M7.5 5L14.5 10L7.5 15Z" stroke="currentColor" stroke-linejoin="round"></path>
            </svg>
          </button>
          <button
            type="button"
            class="round-button"
            data-gallery-previous
            aria-label="Previous photograph"
          >
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M17 10H3M8 5L3 10L8 15" stroke="currentColor"></path>
            </svg>
          </button>
          <button type="button" class="round-button" data-gallery-next aria-label="Next photograph">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M3 10H17M12 5L17 10L12 15" stroke="currentColor"></path>
            </svg>
          </button>
        </div>
      </div>

      <ul class="gallery__thumbs no-scrollbar">
        {gallerySlides.map((slide, index) => (
          <li>
            <button
              type="button"
              data-gallery-thumb
              aria-label={slide.title}
              aria-current={index === 0 ? 'true' : 'false'}
            >
              <span class="gallery__thumb-image">
                <Media shot={slide.shot} sizes="8rem" decorative />
              </span>
              <span class="gallery__thumb-title" aria-hidden="true">
                {slide.title}
              </span>
              <span class="gallery__timer" aria-hidden="true" />
            </button>
          </li>
        ))}
      </ul>
    </div>

    <TextLink href={pageHref('photographs')}>See all the photographs</TextLink>
  </div>
</Scene>

<style>
  /* The position of the edge of light as one picture sweeps in over another.
     Registering it as a percentage is what lets it be animated. */
  @property --sweep {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 130%;
  }

  .gallery__inner {
    display: grid;
    justify-items: start;
    gap: clamp(2.5rem, 6vw, 5.5rem);
    padding-block: var(--section-space);
  }

  .gallery__header {
    display: grid;
    gap: 1.5rem;
    width: 100%;
  }

  .gallery__titles {
    display: grid;
    gap: 1.75rem;
  }

  .gallery__heading {
    font-size: var(--text-display);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .gallery__hint {
    max-width: 20rem;
    font-size: var(--text-small);
  }

  /* On touch screens there is no pointer to move, so the hint would be wrong. */
  @media (hover: none) {
    .gallery__hint {
      display: none;
    }
  }

  .gallery__viewer {
    display: grid;
    gap: 1.75rem;
    width: 100%;
  }

  .gallery__frame {
    position: relative;
  }

  .gallery__glow {
    display: none;
  }

  /* ---- Without scripts: a simple row that scrolls sideways ---- */

  .gallery__stage {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }

  .gallery__slide {
    flex: 0 0 88%;
    scroll-snap-align: start;
  }

  .gallery__picture {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .gallery__slide-caption {
    margin-top: 0.75rem;
    color: var(--ink-muted);
    font-size: var(--text-small);
  }

  .gallery__bar,
  .gallery__thumbs {
    display: none;
  }

  /* ---- With scripts: one picture at a time ---- */

  /* The glow: a blurred copy of each picture behind the frame. Only the
     current one is lit. */
  :global(html.js) .gallery__glow {
    --ambient-reach: 1.16;
    position: absolute;
    inset: 0;
    display: block;
  }

  .gallery__glow :global(.ambient) {
    opacity: 0;
    transition: opacity 2.4s ease;
  }

  .gallery__glow :global(.ambient[data-active]) {
    opacity: 0.62;
  }

  :global(html.js) .gallery__stage {
    position: relative;
    display: block;
    /* On a phone the photographs are landscape, so the frame keeps a calm
       shape that does not crop them away. A wide screen sets its own height. */
    height: auto;
    aspect-ratio: 4 / 3.4;
    overflow: hidden;
    background: #0b0d0e;
    touch-action: pan-y;
  }

  /* A picture waits out of sight. `data-active` is the one being shown, and
     `data-leaving` is the one before it, which stays underneath while the new
     one sweeps in across it. */
  :global(html.js) .gallery__slide {
    position: absolute;
    inset: 0;
    visibility: hidden;
  }

  :global(html.js) .gallery__slide[data-leaving] {
    z-index: 1;
    visibility: visible;
  }

  :global(html.js) .gallery__slide[data-active] {
    z-index: 2;
    visibility: visible;
    -webkit-mask-image: linear-gradient(
      var(--sweep-angle, 100deg),
      #000 calc(var(--sweep) - 30%),
      transparent var(--sweep)
    );
    mask-image: linear-gradient(
      var(--sweep-angle, 100deg),
      #000 calc(var(--sweep) - 30%),
      transparent var(--sweep)
    );
    animation: gallery-sweep 2s var(--ease-in-out) both;
  }

  /* Going back, the sweep runs the other way. */
  :global(html.js) .gallery__stage[data-direction='back'] .gallery__slide[data-active] {
    --sweep-angle: -100deg;
  }

  /* The fade is for browsers that cannot animate the sweep. */
  @keyframes gallery-sweep {
    from {
      --sweep: 0%;
      opacity: 0;
    }

    35% {
      opacity: 1;
    }

    to {
      --sweep: 130%;
      opacity: 1;
    }
  }

  :global(html.js) .gallery__picture {
    position: absolute;
    /* A little larger than the frame, so it can shift without showing an edge. */
    inset: -3%;
    aspect-ratio: auto;
    translate: var(--look-x, 0) var(--look-y, 0);
    transition: translate 2.5s var(--ease-water);
  }

  /* Each picture drifts closer for as long as it is on screen, and carries
     on while the next one sweeps in over it. */
  :global(html.js) .gallery__slide:is([data-active], [data-leaving]) .gallery__picture {
    animation: gallery-drift 11s cubic-bezier(0.25, 0.4, 0.4, 1) both;
  }

  @keyframes gallery-drift {
    from {
      scale: 1.01;
    }

    to {
      scale: 1.12;
    }
  }

  :global(html.js) .gallery__stage[data-looking] .gallery__picture {
    transition-duration: 0.7s;
  }

  :global(html.js) .gallery__slide-caption {
    display: none;
  }

  :global(html.js) .gallery__bar {
    display: grid;
    gap: 1.5rem;
  }

  .gallery__caption {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    min-height: 7.5rem;
    transition:
      opacity 0.5s ease,
      transform 0.9s var(--ease-water);
  }

  /* While the words are being changed they dip out of sight. */
  .gallery__caption[data-changing] {
    opacity: 0;
    transform: translateY(0.6rem);
    transition-duration: 0.3s;
  }

  .gallery__caption-title {
    font-family: var(--font-display);
    font-size: var(--text-heading);
    line-height: 1.2;
  }

  .gallery__caption p:last-child {
    max-width: 32.5rem;
  }

  .gallery__controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .gallery__count {
    margin-right: auto;
    font-size: var(--text-small);
    font-variant-numeric: tabular-nums;
  }

  /* The button shows what it will do: pause while playing, play while paused. */
  .gallery__toggle .gallery__icon-play,
  .gallery__viewer[data-paused] .gallery__toggle .gallery__icon-pause {
    display: none;
  }

  .gallery__viewer[data-paused] .gallery__toggle .gallery__icon-play {
    display: block;
  }

  :global(html.js) .gallery__thumbs {
    display: flex;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    list-style: none;
  }

  .gallery__thumbs li {
    flex: 1 0 4.75rem;
  }

  .gallery__thumbs button {
    position: relative;
    display: block;
    width: 100%;
    height: 4.75rem;
    padding: 0 0 0.625rem;
    border: 0;
    background: none;
    color: inherit;
    text-align: left;
    opacity: 0.45;
    transition: opacity var(--duration-calm) ease;
  }

  .gallery__thumbs button:hover,
  .gallery__thumbs button[aria-current='true'] {
    opacity: 1;
  }

  .gallery__thumb-image {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
  }

  .gallery__thumb-title {
    display: none;
  }

  /* The line under a thumbnail. Under the current one it fills as that
     picture's time runs (`--time` is set by the script, from 0 to 1). */
  .gallery__timer {
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: var(--line);
  }

  .gallery__timer::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .gallery__thumbs button[aria-current='true'] .gallery__timer::after {
    transform: scaleX(var(--time, 1));
  }

  @media (min-width: 56.25em) {
    .gallery__header {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 4rem;
    }

    /* One row: the picture on the left; the caption, the list of photographs
       and the controls in a column beside it, as tall as the picture. The
       caption and the controls are lifted out of their bar
       (`display: contents`) so that they can take their own places. */
    :global(html.js) .gallery__viewer {
      grid-template-columns: minmax(0, 1fr) clamp(17rem, 24vw, 21rem);
      grid-template-rows: auto minmax(0, 1fr) auto;
      gap: 1.75rem clamp(2rem, 3.5vw, 3.5rem);
    }

    :global(html.js) .gallery__frame {
      grid-row: 1 / -1;
    }

    :global(html.js) .gallery__stage {
      height: min(70svh, 40rem);
      aspect-ratio: auto;
    }

    :global(html.js) .gallery__bar {
      display: contents;
    }

    .gallery__caption {
      grid-column: 2;
      grid-row: 1;
      min-height: 0;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--line);
    }

    .gallery__caption p:last-child {
      font-size: var(--text-small);
    }

    .gallery__controls {
      grid-column: 2;
      grid-row: 3;
    }

    /* The list of photographs: a small picture and its title on each line.
       It scrolls on its own if the window is short. */
    :global(html.js) .gallery__thumbs {
      grid-column: 2;
      grid-row: 2;
      flex-direction: column;
      gap: 0.25rem;
      min-height: 0;
      overflow-y: auto;
    }

    .gallery__thumbs li {
      flex: none;
    }

    .gallery__thumbs button {
      display: grid;
      grid-template-columns: 4.75rem minmax(0, 1fr);
      align-items: center;
      gap: 1rem;
      height: auto;
      padding: 0.375rem 0;
      transition:
        opacity var(--duration-calm) ease,
        transform var(--duration-calm) var(--ease-water);
    }

    .gallery__thumbs button:hover,
    .gallery__thumbs button[aria-current='true'] {
      transform: translateX(0.375rem);
    }

    .gallery__thumb-image {
      height: auto;
      aspect-ratio: 3 / 2;
    }

    .gallery__thumb-title {
      display: block;
      overflow: hidden;
      font-family: var(--font-display);
      font-size: 1.1875rem;
      line-height: 1.2;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    /* The timer runs under the title, not the picture. */
    .gallery__timer {
      inset: auto 0 0 5.75rem;
      height: 1px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .gallery__slide[data-active],
    :global(html.js) .gallery__slide:is([data-active], [data-leaving]) .gallery__picture {
      animation: none;
      -webkit-mask-image: none;
      mask-image: none;
    }

    :global(html.js) .gallery__picture,
    .gallery__caption,
    .gallery__glow :global(.ambient) {
      transition: none;
    }
  }
</style>
