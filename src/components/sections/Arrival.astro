---
/**
 * Arrival: walking through the brick gateway into the courtyard.
 * The picture starts as a narrow doorway in a brick wall and opens to fill
 * the screen as the visitor scrolls (scripts/scenes/arrival.ts).
 * Without scripts, or with reduced motion, the picture is simply shown whole.
 */
import Media from '@/components/ui/Media.astro';
import Scene from '@/components/ui/Scene.astro';
import { getScene } from '@/data/scenes';

const scene = getScene('arrival');
---

<Scene id="arrival" class="arrival">
  <div class="arrival__stage feather-y" data-arrival-stage>
    <div class="arrival__wall" aria-hidden="true"></div>
    <div class="arrival__doorway" data-arrival-doorway>
      <div class="arrival__view" data-arrival-view>
        <Media shot="S03" sizes="100vw" />
      </div>
    </div>

    <div class="arrival__panel" data-arrival-panel data-theme="dusk">
      <p class="label">{scene.label}</p>
      <h2 id="arrival-title" class="arrival__heading">
        You come in through a brick gateway, and the road stays behind it.
      </h2>
      <p>
        Inside there is a courtyard, a long channel of still water, and someone waiting with a cold
        towel and a glass of lime.
      </p>
    </div>
  </div>
</Scene>

<style>
  .arrival {
    --hold: 0svh;
    height: calc(100svh + var(--hold));
    min-height: 35rem;
  }

  :global(html[data-motion='full']) .arrival {
    --hold: 60svh;
  }

  .arrival__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 35rem;
    overflow: hidden;
  }

  /* The brick wall around the doorway, with faint courses of brick. */
  .arrival__wall {
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(
        to bottom,
        transparent 0 calc(3.5rem - 1px),
        rgb(0 0 0 / 12%) calc(3.5rem - 1px) 3.5rem
      ),
      var(--color-brick-deep);
  }

  .arrival__doorway,
  .arrival__view {
    position: absolute;
    inset: 0;
  }

  .arrival__panel {
    position: absolute;
    inset: auto var(--gutter) clamp(6rem, 16svh, 9.5rem);
    display: grid;
    gap: 1.1rem;
    padding: 1.625rem 1.5rem;
    background: var(--surface);
    color: var(--ink);
  }

  .arrival__heading {
    font-size: var(--text-title);
    line-height: 1.12;
  }

  @media (min-width: 56.25em) {
    :global(html[data-motion='full']) .arrival {
      --hold: 90svh;
    }

    .arrival__panel {
      inset: 50% auto auto clamp(1rem, 5vw, 5.5rem);
      max-width: 25rem;
      padding: 2rem;
      transform: translateY(-50%);
    }

    .arrival__heading {
      font-size: clamp(1.75rem, 3vw, 2.625rem);
    }
  }
</style>
