---
/**
 * Hero: the opening view. A short film of the reservoir at first light that
 * plays forward as the visitor scrolls (scripts/scenes/hero.ts).
 *
 * How it stays fast and safe:
 * - The first film frame is a normal image, so it shows at once.
 * - The rest of the frames load afterwards and are drawn on the canvas.
 * - Without scripts, or with reduced motion, only the first frame is shown.
 */
import Scene from '@/components/ui/Scene.astro';
import TextLink from '@/components/ui/TextLink.astro';
import sequences from '@/data/frame-sequences.json';
import { bookHref } from '@/data/navigation';
import { sceneHref } from '@/data/scenes';
import { frameUrl } from '@/scripts/lib/frames';

const { desktop, mobile, digits, extension } = sequences.hero;
const desktopPoster = frameUrl(desktop.path, 0, digits, extension);
const mobilePoster = frameUrl(mobile.path, 0, digits, extension);
const narrowScreens = '(max-width: 56.24em)';
---

<Scene id="top" class="hero">
  <div class="hero__stage" data-hero-stage>
    <div class="hero__film feather-bottom">
      <picture>
        <source
          media={narrowScreens}
          srcset={mobilePoster}
          width={mobile.width}
          height={mobile.height}
        />
        <img
          class="hero__poster"
          src={desktopPoster}
          width={desktop.width}
          height={desktop.height}
          alt="The pavilions of Niyara across a misty reservoir at first light."
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <canvas class="hero__canvas" data-hero-canvas aria-hidden="true"></canvas>
    </div>

    <div class="hero__content" data-hero-content>
      <h1 id="top-title" class="hero__title">
        Niyara
      </h1>
      <p class="hero__lead">
        A small hotel on the bank of an old reservoir, twenty minutes from the ancient city of
        Anuradhapura.
      </p>
      <div class="hero__actions">
        <a class="button" href={bookHref}>
          Check availability
        </a>
        <TextLink href={sceneHref('rooms')}>See the rooms</TextLink>
      </div>
    </div>
  </div>
</Scene>

<style>
  .hero {
    /* Extra scroll distance during which the film plays. Zero until the
       scroll scripts switch it on, so the page is never taller than it needs to be. */
    --hold: 0svh;
    height: calc(100svh + var(--hold));
    min-height: 35rem;
  }

  :global(html[data-motion='full']) .hero {
    --hold: 70svh;
  }

  .hero__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 35rem;
    overflow: hidden;
  }

  .hero__film,
  .hero__poster,
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__poster {
    object-fit: cover;
  }

  /* The canvas sits over the first frame and is shown once frames are ready. */
  .hero__canvas {
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .hero__canvas[data-ready] {
    opacity: 1;
  }

  .hero__content {
    position: absolute;
    inset: auto var(--gutter) clamp(3.5rem, 8svh, 6rem);
    display: grid;
    justify-items: start;
    gap: 1.6rem;
  }

  .hero__title {
    font-size: var(--text-hero);
    line-height: 0.95;
    letter-spacing: -0.01em;
  }

  .hero__lead {
    max-width: 29rem;
    font-size: var(--text-lead);
    line-height: 1.6;
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    margin-top: 0.4rem;
  }

  @media (min-width: 56.25em) {
    :global(html[data-motion='full']) .hero {
      --hold: 110svh;
    }

    .hero__actions {
      flex-direction: row;
      align-items: center;
      gap: 2.25rem;
    }
  }
</style>
