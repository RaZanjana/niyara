---
/**
 * Location ("Where we are"): a film of the reservoirs from the air.
 *
 * The camera starts high over the chain of old reservoirs, with the great
 * stupa of the Sacred City on the horizon, and comes down to the bank the
 * hotel stands on. The visitor flies it by scrolling
 * (scripts/scenes/location.ts). Three short texts appear over it in turn:
 * the heading, the story of the reservoirs, and the travel times.
 *
 * The scene begins underneath the end of the opening film and ends on top of
 * the gateway, so each shot dissolves into the next, as in a film.
 *
 * Without scripts, or with reduced motion, it is a still picture with the
 * three texts set out below it.
 */
import Scene from '@/components/ui/Scene.astro';
import sequences from '@/data/frame-sequences.json';
import { destinations, locationIntro } from '@/data/location';
import { getScene } from '@/data/scenes';
import { frameUrl } from '@/scripts/lib/frames';

const scene = getScene('location');
const { desktop, mobile, digits, extension } = sequences.location;
const narrowScreens = '(max-width: 56.24em)';
---

<Scene id="location" class="location">
  <div class="location__stage" data-location-stage>
    <div class="location__film" data-location-film>
      <picture>
        <source
          media={narrowScreens}
          srcset={frameUrl(mobile.path, 0, digits, extension)}
          width={mobile.width}
          height={mobile.height}
        />
        <img
          class="location__poster"
          src={frameUrl(desktop.path, 0, digits, extension)}
          width={desktop.width}
          height={desktop.height}
          alt="A chain of misty reservoirs seen from the air at sunrise. Niyara stands on a grassy bank between two of them, and a great white stupa rises on the horizon."
          decoding="async"
        />
      </picture>
      <canvas class="location__canvas" data-location-canvas aria-hidden="true"></canvas>
    </div>
    <div class="location__veil" aria-hidden="true"></div>

    <div class="location__chapters">
      <div class="location__chapter" data-location-chapter>
        <p class="location__label">{scene.label}</p>
        <h2 id="location-title" class="location__heading" data-location-heading>
          {locationIntro.heading}
        </h2>
      </div>

      <div class="location__chapter" data-location-chapter>
        <p class="location__label">
          <span>{locationIntro.coordinates}</span>
          <span class="location__rule" aria-hidden="true"></span>
          <span>{locationIntro.region}</span>
        </p>
        <p class="location__story">{locationIntro.text}</p>
      </div>

      <div class="location__chapter location__chapter--travel" data-location-chapter>
        <h3 class="location__label">{locationIntro.listLabel}</h3>
        <ul class="location__list">
          {destinations.map((destination) => (
            <li data-location-row>
              <span class="location__place">{destination.name}</span>
              <span class="location__time">{destination.travelTime}</span>
            </li>
          ))}
        </ul>
        <p class="location__note">{locationIntro.note}</p>
      </div>
    </div>

    <!-- A hairline along the bottom that fills as the film plays. -->
    <div class="location__timeline" aria-hidden="true">
      <span data-location-timeline></span>
    </div>
  </div>
</Scene>

<style>
  .location {
    /* `--hold` is the scroll distance over which the film plays. `--overlap`
       is one screen, the distance over which one scene dissolves into the
       next. To be in place underneath the scene before it by then, this
       scene starts two screens up: one to arrive, one for the dissolve. */
    --hold: 0svh;
    --overlap: 0svh;
    z-index: 2;
  }

  .location__stage {
    position: relative;
  }

  .location__film {
    position: relative;
    height: min(72svh, 42rem);
    overflow: hidden;
  }

  .location__poster,
  .location__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The canvas sits over the first frame and is shown once frames are ready. */
  .location__canvas {
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .location__canvas[data-ready] {
    opacity: 1;
  }

  .location__veil,
  .location__timeline {
    display: none;
  }

  .location__chapters {
    display: grid;
    gap: var(--block-space);
    padding: var(--block-space) var(--gutter) var(--section-space);
  }

  .location__chapter {
    display: grid;
    align-content: end;
    justify-items: start;
    gap: 1.5rem;
    max-width: 44rem;
  }

  .location__label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
    font-family: var(--font-text);
    font-size: var(--text-small);
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1.4;
    opacity: 0.9;
  }

  .location__rule {
    width: 2.75rem;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
  }

  .location__heading {
    max-width: 14ch;
    font-size: clamp(2.75rem, 6.4vw, 6.25rem);
    line-height: 0.98;
    letter-spacing: -0.015em;
  }

  .location__story {
    max-width: 34rem;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.2vw, 2rem);
    line-height: 1.3;
  }

  .location__chapter--travel {
    width: 100%;
    max-width: 30rem;
  }

  .location__list {
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .location__list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.95rem;
    border-top: 1px solid rgb(251 248 243 / 28%);
  }

  .location__list li:last-child {
    border-bottom: 1px solid rgb(251 248 243 / 28%);
  }

  .location__place {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.9vw, 1.625rem);
    line-height: 1.2;
  }

  .location__time {
    flex: none;
    font-size: var(--text-small);
    font-variant-numeric: tabular-nums;
    opacity: 0.9;
  }

  .location__note {
    font-size: var(--text-small);
    opacity: 0.85;
  }

  /* ---- With full motion: one screen that holds still while the film plays ---- */

  :global(html[data-motion='full']) .location {
    --hold: 230svh;
    --overlap: var(--screen);
    height: calc(var(--screen) + var(--overlap) + var(--hold) + var(--overlap));
    margin-top: calc(var(--overlap) * -2);
    color: var(--color-on-photo);
    /* A menu link to this section should land where the heading has
       appeared, not on the dissolve that leads into it. */
    scroll-margin-top: -122svh;
    /* The section is taller than what it shows. Let clicks through the empty
       part to the scene underneath. */
    pointer-events: none;
  }

  :global(html[data-motion='full']) .location__stage {
    position: sticky;
    top: 0;
    height: var(--screen);
    min-height: 35rem;
    overflow: hidden;
    background: var(--color-shadow);
    pointer-events: auto;
  }

  :global(html[data-motion='full']) .location__film {
    position: absolute;
    inset: 0;
    height: auto;
  }

  /* The veil: the film's own shadow color, deepest under the words. */
  :global(html[data-motion='full']) .location__veil {
    position: absolute;
    inset: 0;
    display: block;
    background:
      linear-gradient(
        to top,
        rgb(15 18 15 / 84%) 0%,
        rgb(15 18 15 / 56%) 24%,
        rgb(15 18 15 / 16%) 50%,
        transparent 68%
      ),
      linear-gradient(to right, rgb(15 18 15 / 42%), transparent 58%),
      linear-gradient(to bottom, rgb(15 18 15 / 30%), transparent 22%);
    pointer-events: none;
  }

  /* The three texts share one place, low on the left, and take turns. */
  :global(html[data-motion='full']) .location__chapters {
    position: absolute;
    inset: auto var(--gutter) calc(clamp(4.5rem, 11svh, 7.5rem) + var(--bars));
    gap: 0;
    padding: 0;
  }

  :global(html[data-motion='full']) .location__chapter {
    grid-area: 1 / 1;
    align-self: end;
    text-shadow: 0 0 1.75rem rgb(15 18 15 / 50%);
  }

  :global(html[data-motion='full']) .location__timeline {
    position: absolute;
    inset: auto var(--gutter) calc(clamp(2.25rem, 5.5svh, 3.75rem) + var(--bars));
    display: block;
    height: 1px;
    background: rgb(251 248 243 / 22%);
  }

  .location__timeline span {
    display: block;
    height: 100%;
    background: var(--color-on-photo);
    transform: scaleX(0);
    transform-origin: left;
  }

  @media (min-width: 56.25em) {
    :global(html[data-motion='full']) .location {
      --hold: 300svh;
    }
  }
</style>
