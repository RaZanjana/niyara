---
/**
 * Rooms: the three kinds of villa, each with several pictures.
 *
 * - Choosing a kind of villa dissolves to its pictures and shows its
 *   description. The markup follows the standard "tabs" pattern, so it works
 *   with a keyboard and a screen reader.
 * - Each villa's pictures change with the arrows on the picture, the small
 *   pictures underneath it, a swipe, or the left and right keys. The next
 *   picture fades in over the last and settles slowly back into place.
 *
 * The behavior is in scripts/ui/rooms.ts. Without scripts every villa is
 * shown one after another, each with all its pictures.
 */
import Media from '@/components/ui/Media.astro';
import Scene from '@/components/ui/Scene.astro';
import SectionIntro from '@/components/ui/SectionIntro.astro';
import TextLink from '@/components/ui/TextLink.astro';
import { rooms, roomsIntro } from '@/data/rooms';
import { pageHref } from '@/data/routes';
import { shots } from '@/data/shots';

const twoDigits = (value: number) => String(value).padStart(2, '0');
---

<Scene id="rooms" class="rooms">
  <div class="container rooms__inner" data-scene-body>
    <SectionIntro scene="rooms" heading={roomsIntro.heading}>
      <p>{roomsIntro.text}</p>
    </SectionIntro>

    <div class="rooms__chooser" data-rooms>
      <div class="rooms__view" data-reveal>
        <div class="rooms__stage" data-room-stage>
          {rooms.map((room, index) => (
            <div
              class="rooms__room"
              data-room-picture={room.id}
              data-active={index === 0}
              role="group"
              aria-roledescription="carousel"
              aria-label={`Pictures of the ${room.name}`}
            >
              {room.shots.map((shot, shotIndex) => (
                <div class="rooms__picture" data-room-frame data-active={shotIndex === 0}>
                  <Media
                    shot={shot}
                    sizes="(min-width: 56.25em) 58vw, 100vw"
                    loading={index === 0 && shotIndex === 0 ? 'eager' : 'lazy'}
                  />
                </div>
              ))}
            </div>
          ))}

          <div class="rooms__nav">
            <p class="rooms__count" aria-live="polite" data-room-count>
              01 / {twoDigits(rooms[0]?.shots.length ?? 1)}
            </p>
            <button
              type="button"
              class="rooms__step"
              data-room-previous
              aria-label="Previous picture"
            >
              <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none">
                <path d="M17 10H3M8 5L3 10L8 15" stroke="currentColor"></path>
              </svg>
            </button>
            <button type="button" class="rooms__step" data-room-next aria-label="Next picture">
              <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none">
                <path d="M3 10H17M12 5L17 10L12 15" stroke="currentColor"></path>
              </svg>
            </button>
          </div>
        </div>

        {rooms.map((room, index) => (
          <ul class="rooms__thumbs" data-room-thumbs={room.id} hidden={index !== 0}>
            {room.shots.map((shot, shotIndex) => (
              <li>
                <button
                  type="button"
                  data-room-thumb
                  aria-label={shots[shot].name}
                  aria-current={shotIndex === 0 ? 'true' : 'false'}
                >
                  <Media shot={shot} sizes="9rem" decorative />
                </button>
              </li>
            ))}
          </ul>
        ))}
      </div>

      <div class="rooms__details" data-reveal>
        <div class="rooms__tabs" role="tablist" aria-label="Kinds of villa">
          {rooms.map((room, index) => (
            <button
              type="button"
              role="tab"
              id={`room-tab-${room.id}`}
              aria-controls={`room-panel-${room.id}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              data-room-tab={room.id}
            >
              <span class="rooms__name">{room.name}</span>
              <span class="rooms__price">{room.priceFrom}</span>
            </button>
          ))}
        </div>

        {rooms.map((room) => (
          <div
            class="rooms__panel"
            role="tabpanel"
            id={`room-panel-${room.id}`}
            aria-labelledby={`room-tab-${room.id}`}
            data-room-panel={room.id}
          >
            <p>{room.description}</p>
          </div>
        ))}

        <div class="rooms__links">
          <TextLink href={pageHref('rooms')}>See this villa</TextLink>
          <TextLink href={pageHref('rooms')}>Compare all three</TextLink>
        </div>
      </div>
    </div>
  </div>
</Scene>

<style>
  .rooms__inner {
    display: grid;
    gap: var(--block-space);
    padding-block: var(--section-space);
  }

  .rooms__chooser {
    display: grid;
    gap: 2rem;
  }

  .rooms__view {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  /* ---- Without scripts: every villa's pictures, one villa after another ---- */

  .rooms__stage {
    display: grid;
    gap: 1rem;
  }

  .rooms__room {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .rooms__room .rooms__picture:first-child {
    grid-column: 1 / -1;
  }

  .rooms__picture {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .rooms__nav,
  .rooms__thumbs {
    display: none;
  }

  .rooms__details {
    display: grid;
    align-content: start;
    gap: 2rem;
  }

  .rooms__tabs {
    display: grid;
    border-bottom: 1px solid var(--line);
  }

  .rooms__tabs button {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.125rem 1rem;
    min-height: 2.75rem;
    padding: 1.25rem 0;
    border: 0;
    border-top: 1px solid var(--line);
    background: none;
    color: var(--ink-muted);
    text-align: left;
    transition:
      color var(--duration-quick) ease,
      padding-left var(--duration-calm) var(--ease-water);
  }

  .rooms__tabs button:hover {
    color: var(--ink);
  }

  .rooms__tabs button[aria-selected='true'] {
    padding-left: 0.875rem;
    color: var(--ink);
    box-shadow: inset 2px 0 0 var(--accent);
  }

  .rooms__name {
    font-family: var(--font-display);
    font-size: var(--text-heading);
    line-height: 1.2;
  }

  .rooms__price {
    font-size: var(--text-small);
  }

  .rooms__panel p {
    max-width: 27rem;
  }

  .rooms__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 2.25rem;
  }

  /* ---- With scripts: one picture at a time ---- */

  :global(html.js) .rooms__stage {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface-raised);
    touch-action: pan-y;
  }

  /* A villa's pictures stay in place while hidden, so changing back is instant. */
  :global(html.js) .rooms__room {
    position: absolute;
    inset: 0;
    display: block;
    visibility: hidden;
    opacity: 0;
    transition:
      opacity 1.2s ease,
      visibility 0s 1.2s;
  }

  :global(html.js) .rooms__room[data-active] {
    z-index: 1;
    visibility: visible;
    opacity: 1;
    transition-delay: 0s;
  }

  /* The picture coming in fades over the last, a little close, and settles
     slowly back: a gentle push out, as a camera would. */
  :global(html.js) .rooms__picture {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
    opacity: 0;
    transform: scale(1.07);
    transition:
      opacity 1.1s ease,
      transform 0s 1.1s;
  }

  :global(html.js) .rooms__picture[data-active] {
    z-index: 1;
    opacity: 1;
    transform: none;
    transition:
      opacity 1.1s ease,
      transform 7s var(--ease-water);
  }

  /* The counter and the arrows, on a soft shadow at the foot of the picture. */
  :global(html.js) .rooms__nav {
    position: absolute;
    inset: auto 0 0;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 3.5rem 1.25rem 1.1rem;
    background: linear-gradient(to top, rgb(15 18 15 / 55%), rgb(15 18 15 / 0%));
    color: var(--color-on-photo);
    pointer-events: none;
  }

  .rooms__count {
    margin-right: auto;
    font-size: var(--text-fine);
    letter-spacing: 0.12em;
    font-variant-numeric: tabular-nums;
  }

  .rooms__step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid rgb(251 248 243 / 55%);
    border-radius: 50%;
    background: rgb(15 18 15 / 18%);
    color: inherit;
    pointer-events: auto;
    transition:
      background-color var(--duration-quick) ease,
      border-color var(--duration-quick) ease,
      color var(--duration-quick) ease;
  }

  .rooms__step:hover {
    border-color: var(--color-on-photo);
    background: var(--color-on-photo);
    color: var(--color-charcoal);
  }

  :global(html.js) .rooms__thumbs {
    display: flex;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  :global(html.js) .rooms__thumbs[hidden] {
    display: none;
  }

  .rooms__thumbs li {
    flex: 0 1 8.5rem;
  }

  .rooms__thumbs button {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    padding: 0;
    border: 0;
    background: none;
    opacity: 0.5;
    transition: opacity var(--duration-calm) ease;
  }

  .rooms__thumbs button:hover,
  .rooms__thumbs button[aria-current='true'] {
    opacity: 1;
  }

  /* A line under the current small picture, in the accent color. */
  .rooms__thumbs button::after {
    content: '';
    position: absolute;
    inset: auto 0 -0.45rem;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-calm) var(--ease-water);
  }

  .rooms__thumbs button[aria-current='true']::after {
    transform: scaleX(1);
  }

  /* Keeps the text block from jumping as descriptions change length. */
  :global(html.js) .rooms__panel {
    min-height: 8.5rem;
  }

  @media (min-width: 56.25em) {
    .rooms__chooser {
      grid-template-columns: minmax(0, 1.65fr) minmax(20rem, 1fr);
      align-items: end;
      gap: 5.5rem;
    }

    :global(html.js) .rooms__stage {
      aspect-ratio: 16 / 11;
    }

    .rooms__details {
      gap: 2.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .rooms__room,
    :global(html.js) .rooms__picture,
    :global(html.js) .rooms__picture[data-active] {
      transform: none;
      transition: none;
    }
  }
</style>
