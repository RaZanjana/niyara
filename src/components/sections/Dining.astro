---
/**
 * Dining: the restaurant as dusk turns to night.
 *
 * The film fills the screen and holds still while the visitor scrolls: the
 * sky darkens and the lanterns come on (scripts/scenes/dining.ts). The words
 * come in on the right once that side of the picture has gone dark, so they
 * are set on the night itself, with the gold of the lanterns as their accent.
 * The page changes from day to night behind the film, and the film's top and
 * bottom edges melt into its own glow: dusk above, night below.
 *
 * Two photographs lie under the film and cross-fade the same way until it
 * has loaded. Without scripts the night picture is shown, with the words.
 */
import { existsSync } from 'node:fs';
import Ambient from '@/components/ui/Ambient.astro';
import Media from '@/components/ui/Media.astro';
import Scene from '@/components/ui/Scene.astro';
import TextLink from '@/components/ui/TextLink.astro';
import sequences from '@/data/frame-sequences.json';
import { pageHref } from '@/data/routes';
import { getScene } from '@/data/scenes';
import { publicFile } from '@/lib/ambient';
import { frameUrl } from '@/scripts/lib/frames';

const scene = getScene('dining');

// The film is only switched on if its frames are in the project. Without
// them, the two photographs cross-fade instead and nothing is missing.
const { desktop, digits, extension } = sequences.dining;
const hasFilm = existsSync(publicFile(frameUrl(desktop.path, 0, digits, extension)));
---

<Scene id="dining" class="dining">
  <div class="dining__stage" data-dining>
    <div class="dining__glow">
      <Ambient shot="S15" />
      <Ambient shot="S16" class="dining__glow-night" data-dining-night />
    </div>

    <div class="dining__frame feather-y">
      <div class="dining__layers" data-dining-layers>
        <div class="dining__layer">
          <Media shot="S15" sizes="100vw" />
        </div>
        <div class="dining__layer dining__layer--night" data-dining-night>
          <Media shot="S16" sizes="100vw" decorative />
        </div>
        {hasFilm && <canvas class="dining__film" data-dining-canvas aria-hidden="true" />}
      </div>
      <div class="dining__shade" data-dining-shade aria-hidden="true"></div>
    </div>

    <div class="dining__text" data-dining-text>
      <p class="dining__label" data-dining-line>
        {scene.label}
      </p>
      <h2 id="dining-title" class="dining__heading" data-dining-line>
        Dinner is on the bank, as the lamps are lit.
      </h2>
      <p data-dining-line>
        The Ambalama is our one restaurant: a long hall open on three sides to the water, with the
        bar and an open kitchen along the fourth. The cooking belongs to this part of the island:
        red rice from the fields next door, fish from the reservoir, buffalo curd with palm treacle.
        Most of it is cooked over wood, where you can watch.
      </p>
      <p class="dining__note" data-dining-line>
        On full moon days no alcohol is served anywhere in Sri Lanka, including here. We make a very
        good lime and ginger soda instead.
      </p>
      <div data-dining-line>
        <TextLink href={pageHref('dining')}>Menus and opening hours</TextLink>
      </div>
    </div>
  </div>
</Scene>

<style>
  .dining {
    /* Extra scroll distance during which night falls. Zero until the scroll
       scripts switch it on, and only on a wide screen. */
    --hold: 0svh;
  }

  /* On a phone the words stand below the picture. They get the night color
     of the section as their own ground, so they do not depend on how far
     the page behind has darkened yet. */
  .dining__stage {
    position: relative;
    display: grid;
    background: linear-gradient(to bottom, transparent 42svh, var(--surface) 66svh);
  }

  .dining__glow,
  .dining__layers,
  .dining__layer,
  .dining__film,
  .dining__shade {
    position: absolute;
    inset: 0;
  }

  .dining__glow {
    --ambient-reach: 1.1;
    --ambient-blur: 2.5rem;
    /* On a phone the glow belongs to the picture, not to the text below it. */
    bottom: auto;
    height: 62svh;
    min-height: 24rem;
  }

  .dining__frame {
    --feather: 15%;
    position: relative;
    height: 62svh;
    min-height: 24rem;
    overflow: hidden;
  }

  /* The film covers the two photographs once its first frame is drawn. */
  .dining__film {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .dining__film[data-ready] {
    opacity: 1;
  }

  /* Night is the resting state. The scroll script starts at dusk instead,
     and brings the night in. */
  .dining__shade {
    display: none;
  }

  .dining__text {
    position: relative;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1.4rem;
    padding: 1.5rem var(--gutter) var(--section-space);
  }

  .dining__text p {
    max-width: 27.5rem;
  }

  .dining__label {
    color: var(--accent);
    font-size: var(--text-small);
    letter-spacing: 0.04em;
  }

  .dining__heading {
    max-width: 14ch;
    font-size: var(--text-title);
    line-height: 1.04;
    letter-spacing: -0.01em;
  }

  .dining__note {
    color: var(--ink-muted);
    font-size: var(--text-small);
  }

  @media (min-width: 56.25em) {
    .dining {
      height: calc(var(--screen) + var(--hold));
      min-height: 42rem;
    }

    :global(html[data-motion='full']) .dining {
      --hold: 115svh;
    }

    .dining__stage {
      position: sticky;
      top: 0;
      height: var(--screen);
      min-height: 42rem;
      background: none;
    }

    .dining__glow {
      --ambient-reach: 1.2;
      --ambient-blur: 3.5rem;
      bottom: 0;
      height: auto;
    }

    .dining__frame {
      position: absolute;
      inset: 0;
      height: auto;
      min-height: 0;
    }

    /* Darkens the right of the picture, under the words, in the color of
       the night around the restaurant. */
    .dining__shade {
      display: block;
      background:
        linear-gradient(
          to left,
          rgb(16 12 8 / 88%) 0%,
          rgb(16 12 8 / 70%) 26%,
          rgb(16 12 8 / 22%) 48%,
          transparent 60%
        ),
        linear-gradient(to top, rgb(16 12 8 / 45%), transparent 34%);
    }

    .dining__text {
      align-self: center;
      justify-self: end;
      width: min(31rem, 38vw);
      margin-right: var(--gutter);
      padding: 0;
      text-shadow: 0 0 1.5rem rgb(16 12 8 / 60%);
    }
  }
</style>
