---
/**
 * LocationMap: a hand-drawn style map of the hotel, the reservoirs and the roads.
 * Each road has `data-road="<destination id>"`, so scripts can draw it in
 * and highlight it when its destination is chosen (scripts/ui/location.ts).
 * The map is a drawing, so screen readers get a one-line description instead.
 */
import type { DestinationId } from '@/data/location';

const roads: { id: DestinationId; path: string }[] = [
  { id: 'sacred-city', path: 'M424 276 C500 292 570 304 644 332' },
  { id: 'mihintale', path: 'M424 276 C520 286 700 300 800 272' },
  { id: 'wilpattu', path: 'M408 288 C360 360 200 384 70 380' },
  { id: 'colombo', path: 'M416 290 C420 340 440 376 468 398' },
];
---

<svg
  class="map"
  viewBox="0 0 860 420"
  role="img"
  aria-label="Map showing Niyara on the bank of a reservoir, with roads to the Sacred City, Mihintale, Wilpattu and Colombo."
  data-map
>
  <!-- The old canal that links the reservoirs -->
  <path
    class="map__canal"
    d="M650 62 C610 110 570 122 524 150 C470 190 440 204 392 236"
    fill="none"
  ></path>

  <!-- Water -->
  <g class="map__water">
    <ellipse cx="664" cy="52" rx="46" ry="22"></ellipse>
    <ellipse cx="524" cy="150" rx="64" ry="30"></ellipse>
    <path d="M150 250 C190 205 330 200 400 232 C440 250 430 300 380 318 C300 345 190 335 150 300 C132 284 134 266 150 250 Z"></path>
  </g>

  <!-- The bank the hotel stands on -->
  <path class="map__bank" d="M400 232 C440 250 430 300 380 318" fill="none"></path>

  <!-- Roads -->
  {roads.map((road) => (
    <path class="map__road" d={road.path} pathLength="1" data-road={road.id} />
  ))}

  <!-- Places -->
  <rect class="map__hotel" x="408" y="268" width="12" height="12"></rect>
  <circle class="map__place" cx="649" cy="333" r="5"></circle>
  <circle class="map__place" cx="805" cy="269" r="5"></circle>

  <text class="map__name" x="434" y="262">
    Niyara
  </text>
  <text class="map__note" x="602" y="154">
    The old canal
  </text>
  <text x="662" y="358">
    The Sacred City
  </text>
  <text x="730" y="250">
    Mihintale
  </text>
  <text x="40" y="408">
    To Wilpattu
  </text>
  <text x="482" y="408">
    To Colombo
  </text>
</svg>

<style>
  .map {
    width: 100%;
    height: auto;
    font-family: var(--font-text);
    font-size: 13px;
    fill: var(--ink);
  }

  .map__water {
    fill: color-mix(in srgb, var(--surface) 80%, var(--ink-muted));
    stroke: var(--ink);
    stroke-width: 1;
  }

  .map__canal {
    stroke: var(--ink-muted);
    stroke-width: 1;
    stroke-dasharray: 2 5;
  }

  .map__bank {
    stroke: var(--ink);
    stroke-width: 3;
  }

  .map__road {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
    /* With pathLength="1", a dash of 1 is the whole road. Scripts move the
       dash offset from 1 to 0 to draw the road in. */
    stroke-dasharray: 1;
    transition:
      stroke var(--duration-quick) ease,
      stroke-width var(--duration-quick) ease;
  }

  .map__road[data-active] {
    stroke: var(--accent);
    stroke-width: 3;
  }

  .map__hotel {
    fill: var(--accent);
  }

  .map__place {
    fill: var(--surface);
    stroke: var(--ink);
    stroke-width: 1;
  }

  .map__name {
    font-family: var(--font-display);
    font-size: 26px;
  }

  .map__note {
    fill: var(--ink-muted);
  }

  /* The map is drawn 860 units wide. On a phone it is shown at less than half
     that size, so the lettering is drawn larger to stay readable. */
  @media (max-width: 40em) {
    .map {
      font-size: 24px;
    }

    .map__name {
      font-size: 40px;
    }
  }
</style>
