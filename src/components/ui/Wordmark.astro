---
/**
 * Wordmark: the hotel name in wide-spaced capitals over one thin line,
 * the "water line". It is type, not an image, so it takes the text color.
 */
interface Props {
  size?: 'small' | 'regular';
}

const { size = 'regular' } = Astro.props;
---

<span class:list={['wordmark', `wordmark--${size}`]}>
  <span class="wordmark__name">NIYARA</span>
  <span class="wordmark__line" aria-hidden="true"></span>
</span>

<style>
  .wordmark {
    --spacing: 0.34em;
    display: inline-flex;
    flex-direction: column;
    gap: 0.45rem;
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1;
    letter-spacing: var(--spacing);
  }

  .wordmark--small {
    --spacing: 0.3em;
    font-size: 1.125rem;
  }

  .wordmark__line {
    height: 1px;
    /* Letter spacing adds a gap after the last letter. Pull the line back to match. */
    margin-right: var(--spacing);
    background: currentColor;
  }
</style>
