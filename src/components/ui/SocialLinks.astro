---
/**
 * SocialLinks: "Follow us", with a round icon for each of the hotel's pages
 * elsewhere (`site.social`). Each link is named for screen readers, and opens
 * in a new tab.
 */
import { site } from '@/data/site';

interface Props {
  /** Shown above the icons. */
  label?: string;
  class?: string;
}

const { label = 'Follow us', class: className } = Astro.props;

/** Simple line drawings, 24 units square, drawn with the text color. */
const icons: Record<string, string> = {
  Instagram:
    '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.25" cy="6.75" r="0.6" fill="currentColor"/>',
  Facebook: '<path d="M15.5 3.5h-2.25a3.75 3.75 0 0 0-3.75 3.75V20.5M6.75 10.5h7.5"/>',
  YouTube:
    '<rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10.25 9.25v5.5l4.75-2.75z" fill="currentColor"/>',
  TikTok:
    '<path d="M13.5 3.5v11.25a3.25 3.25 0 1 1-3.25-3.25"/><path d="M13.5 3.5c.35 2.55 2.1 4.3 4.75 4.5"/>',
};
---

<div class:list={['social', className]}>
  <p class="social__label">{label}</p>
  <ul class="social__list">
    {site.social.map((page) => (
      <li>
        <a
          class="social__link"
          href={page.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${page.name} (opens in a new tab)`}
        >
          <svg
            aria-hidden="true"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={icons[page.name] ?? ''}
          />
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .social {
    display: grid;
    gap: 1rem;
  }

  .social__label {
    color: var(--ink-muted);
    font-size: var(--text-small);
    letter-spacing: 0.04em;
  }

  .social__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* A round button whose color fills from the bottom on hover, like water rising. */
  .social__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: var(--ink);
    isolation: isolate;
    transition:
      border-color var(--duration-quick) ease,
      color var(--duration-calm) var(--ease-water);
  }

  .social__link::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--accent);
    transform: translateY(101%);
    transition: transform var(--duration-calm) var(--ease-water);
  }

  .social__link:hover,
  .social__link:focus-visible {
    border-color: var(--accent);
    color: var(--color-charcoal);
  }

  .social__link:hover::before,
  .social__link:focus-visible::before {
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .social__link,
    .social__link::before {
      transition: none;
    }
  }
</style>
