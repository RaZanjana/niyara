---
/**
 * Media: one photograph from the shot list.
 *
 * If the picture file exists (`src/assets/images/<ID>.jpg` and so on), it is
 * shown as a responsive image in modern formats. If it does not exist yet, a
 * flat stand-in block is shown in its place, with the shot's ID and name.
 * So adding a picture needs no code change: just add the file.
 *
 * The picture always fills its parent, so give the parent a size.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { shots, type ShotId } from '@/data/shots';
import { contrastRatio, parseHex } from '@/scripts/lib/color';

interface Props {
  shot: ShotId;
  /** How wide the picture is shown, for the browser to pick a file size. */
  sizes: string;
  /** Use "eager" only for pictures visible when the page first opens. */
  loading?: 'lazy' | 'eager';
  /** Set to true for decorative repeats, such as thumbnails. */
  decorative?: boolean;
  class?: string;
}

const { shot: id, sizes, loading = 'lazy', decorative = false, class: className } = Astro.props;
const shot: { name: string; alt: string; tone: string; focus?: string } = shots[id];

// Find every picture file once, at build time, and index it by shot ID.
const files = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/*.{avif,jpg,jpeg,png,webp}',
  { eager: true },
);
const fileFor = (shotId: string) =>
  Object.entries(files).find(([path]) => path.split('/').pop()?.split('.')[0] === shotId)?.[1]
    .default;

const image = fileFor(id);
const alt = decorative ? '' : shot.alt;

// Pick a readable label color for the stand-in block.
const tone = parseHex(shot.tone);
const labelColor =
  contrastRatio(tone, parseHex('#1f2623')) > contrastRatio(tone, parseHex('#fbf8f3'))
    ? '#1f2623'
    : '#fbf8f3';
---

<div
  class:list={['media', className]}
  style={`--tone: ${shot.tone}; --focus: ${shot.focus ?? '50% 50%'}`}
>
  {image ? (
    <Picture
      class="media__asset"
      src={image}
      alt={alt}
      sizes={sizes}
      widths={[480, 800, 1200, 1600, 2400]}
      formats={['avif', 'webp']}
      loading={loading}
      decoding="async"
    />
  ) : (
    <div
      class="media__asset media__stand-in"
      role={decorative ? undefined : 'img'}
      aria-label={decorative ? undefined : alt}
      aria-hidden={decorative ? 'true' : undefined}
      style={`color: ${labelColor}`}
    >
      {!decorative && (
        <span class="media__note">
          {id} · {shot.name}
        </span>
      )}
    </div>
  )}
</div>

<style>
  .media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--tone);
  }

  .media :global(.media__asset),
  .media :global(.media__asset img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus);
  }

  .media__stand-in {
    /* The note sits in the middle, so it is never cut off when a picture is
       cropped or drifts with the scroll. */
    display: grid;
    place-items: center;
    padding: 1rem 1.25rem;
    text-align: center;
    background: var(--tone);
  }

  .media__note {
    font-size: 0.75rem;
    line-height: 1.4;
    letter-spacing: 0.04em;
    opacity: 0.75;
  }
</style>
