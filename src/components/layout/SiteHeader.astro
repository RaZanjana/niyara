---
/**
 * SiteHeader: the bar fixed to the top of the page.
 *
 * It has no solid background. Behind it sits a pane of frosted glass, tinted
 * with the color of the section it is over (`--page-bg`, kept up to date by
 * scripts/scenes/atmosphere.ts) and fading out downwards. So the picture or
 * film behind the bar shows through it, softened, and the bar takes its colors.
 *
 * Wide screens show the links. Narrow screens show "Book" and a round menu
 * button that opens the full-screen menu (SiteMenu). "Book a stay" opens the
 * booking window (BookingModal); without scripts it is a link to the booking
 * section.
 */
import Wordmark from '@/components/ui/Wordmark.astro';
import { bookHref, primaryNav } from '@/data/navigation';
import { sceneHref } from '@/data/scenes';
---

<header class="header" data-header data-tinted>
  <a class="header__home" href={sceneHref('top')} aria-label="Niyara, back to the top">
    <Wordmark />
  </a>

  <nav class="header__nav" aria-label="Main">
    <ul class="header__links">
      {primaryNav.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))}
    </ul>
    <a class="header__book" href={bookHref} data-book-open aria-haspopup="dialog">
      <span class="header__book-long">Book a stay</span>
      <span class="header__book-short">Book</span>
    </a>
    <button
      class="header__menu"
      type="button"
      data-menu-open
      aria-haspopup="dialog"
      aria-label="Menu"
    >
      <svg aria-hidden="true" width="20" height="12" viewBox="0 0 20 12" fill="none">
        <path d="M0 1.5H20M0 10.5H20" stroke="currentColor" stroke-width="1.25"></path>
      </svg>
    </button>
  </nav>
</header>

<style>
  .header {
    position: absolute;
    inset: 0 0 auto;
    z-index: var(--layer-header);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: var(--header-height);
    padding-inline: var(--gutter);
    color: var(--page-ink, var(--ink));
    transition: color 0.5s linear;
  }

  /* With scripts running the bar stays on screen and follows the page color. */
  :global(html.js) .header {
    position: fixed;
  }

  /* The pane of glass. It is taller than the bar and fades out at the bottom,
     so the bar has no lower edge at all. */
  .header::before {
    --tint: var(--page-bg, var(--surface));
    content: '';
    position: absolute;
    inset: 0 0 -3rem;
    z-index: -1;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--tint) 62%, transparent),
      color-mix(in srgb, var(--tint) 34%, transparent) 55%,
      color-mix(in srgb, var(--tint) 0%, transparent)
    );
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 38%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0, #000 38%, transparent 100%);
    pointer-events: none;
  }

  /* On touch screens the glass is a deeper tint without the blur: blurring a
     moving film behind the bar on every frame is too much for a phone. */
  @media (hover: none), (max-width: 56.24em) {
    .header::before {
      background: linear-gradient(
        to bottom,
        color-mix(in srgb, var(--tint) 78%, transparent),
        color-mix(in srgb, var(--tint) 44%, transparent) 55%,
        color-mix(in srgb, var(--tint) 0%, transparent)
      );
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  .header__home {
    padding-block: 0.5rem;
    text-decoration: none;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .header__links {
    display: none;
    gap: 2.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-small);
  }

  .header__links a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    text-decoration: none;
  }

  /* A hairline that draws in under a link, from the left. */
  .header__links a::after {
    content: '';
    position: absolute;
    inset: auto 0 0.55rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--duration-calm) var(--ease-water);
  }

  .header__links a:hover::after,
  .header__links a:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .header__menu,
  .header__book {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.75rem;
    border: 1px solid color-mix(in srgb, currentColor 55%, transparent);
    border-radius: var(--radius-pill);
    font-size: var(--text-small);
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
  }

  /* The menu button is a plain round icon. Its name is read out, not shown. */
  .header__menu {
    width: 2.75rem;
    padding: 0;
    background: none;
    transition: border-color var(--duration-quick) ease;
  }

  .header__menu:hover {
    border-color: currentColor;
  }

  .header__book {
    padding-inline: 1.25rem;
    border-color: var(--page-ink, var(--ink));
    background: var(--page-ink, var(--ink));
    color: var(--page-bg, var(--surface));
    transition:
      background-color 0.5s linear,
      border-color 0.5s linear,
      color 0.5s linear,
      transform var(--duration-calm) var(--ease-water);
  }

  .header__book:hover {
    transform: scale(1.04);
  }

  .header__book-long {
    display: none;
  }

  @media (min-width: 56.25em) {
    .header__nav {
      gap: 2.5rem;
    }

    .header__links {
      display: flex;
    }

    .header__menu,
    .header__book-short {
      display: none;
    }

    .header__book {
      padding-inline: 1.5rem;
    }

    .header__book-long {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header__links a::after,
    .header__book {
      transition: none;
    }
  }
</style>
