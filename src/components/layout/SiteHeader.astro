---
/**
 * SiteHeader: the bar fixed to the top of the page.
 * Wide screens show the links. Narrow screens show a Menu button that opens
 * the full-screen menu (SiteMenu). The bar takes the color of the page behind
 * it, which scripts/scenes/atmosphere.ts keeps in `--page-bg` and `--page-ink`.
 */
import Wordmark from '@/components/ui/Wordmark.astro';
import { bookHref, primaryNav } from '@/data/navigation';
import { sceneHref } from '@/data/scenes';
---

<header class="header">
  <a class="header__home" href={sceneHref('top')} aria-label="Niyara, back to the top">
    <Wordmark />
  </a>

  <nav class="header__nav" aria-label="Main">
    <ul class="header__links">
      {primaryNav.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))}
    </ul>
    <button class="header__menu" type="button" data-menu-open aria-haspopup="dialog">
      <span>Menu</span>
      <svg aria-hidden="true" width="18" height="12" viewBox="0 0 18 12" fill="none">
        <path d="M0 3H18M0 9H18" stroke="currentColor" stroke-width="1.5"></path>
      </svg>
    </button>
    <a class="header__book" href={bookHref}>
      <span class="header__book-long">Book a stay</span>
      <span class="header__book-short">Book</span>
    </a>
  </nav>
</header>

<style>
  .header {
    position: absolute;
    inset: 0 0 auto;
    z-index: var(--layer-header);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: var(--header-height);
    padding-inline: var(--gutter);
    background: var(--page-bg, var(--color-mist));
    color: var(--page-ink, #1c2428);
    transition: color 0.4s linear;
  }

  /* With scripts running the bar stays on screen and follows the page color. */
  :global(html.js) .header {
    position: fixed;
  }

  /* A soft fade under the bar, so content slides away under it without a hard edge. */
  .header::after {
    content: '';
    position: absolute;
    inset: 100% 0 auto;
    height: 2.25rem;
    background: linear-gradient(
      to bottom,
      var(--page-bg, var(--color-mist)),
      color-mix(in srgb, var(--page-bg, var(--color-mist)) 0%, transparent)
    );
    pointer-events: none;
  }

  .header__home {
    padding-block: 0.5rem;
    text-decoration: none;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .header__links {
    display: none;
    gap: 2.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-small);
  }

  .header__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    text-decoration: none;
  }

  .header__links a:hover {
    text-decoration: underline;
    text-underline-offset: 0.4em;
    text-decoration-thickness: 1px;
  }

  .header__menu,
  .header__book {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    height: 2.75rem;
    padding-inline: 1rem;
    border: 1px solid currentColor;
    border-radius: var(--radius-pill);
    font-size: var(--text-small);
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
  }

  .header__menu {
    background: none;
  }

  .header__book {
    padding-inline: 1.25rem;
    border-color: var(--page-ink, #1c2428);
    background: var(--page-ink, #1c2428);
    color: var(--page-bg, var(--color-mist));
    transition:
      background-color 0.4s linear,
      color 0.4s linear;
  }

  .header__book-long {
    display: none;
  }

  @media (min-width: 56.25em) {
    .header__nav {
      gap: 2.5rem;
    }

    .header__links {
      display: flex;
    }

    .header__menu,
    .header__book-short {
      display: none;
    }

    .header__book {
      padding-inline: 1.5rem;
    }

    .header__book-long {
      display: inline;
    }
  }
</style>
