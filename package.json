{
  "name": "niyara",
  "description": "Homepage of Niyara, a private estate of luxury villas on an ancient reservoir near Anuradhapura, Sri Lanka.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run placeholders && npm run stamp && astro dev",
    "build": "npm run placeholders && npm run stamp && astro build",
    "preview": "astro preview",
    "placeholders": "node scripts/generate-placeholder-frames.mjs",
    "stamp": "node scripts/stamp-frames.mjs",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "verify": "npm run format:check && npm run lint && npm run check && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/noto-serif-sinhala": "^5.3.0",
    "astro": "^7.4.12",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
